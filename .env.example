# Copy to .env and supply local credentials; never commit .env.
# This is a template, not a verified server connection.
DATABASE_URL=postgres://ims_user:CHANGE_ME@127.0.0.1:5432/ims_dev?sslmode=disable
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql
DBMATE_STRICT=true
# Serialize migration runners; this does not replace business transaction locking.
DBMATE_MIGRATION_LOCK=true
